# Docker Environment Configuration for Company Leave Management System
# Copy this to .env and customize for your deployment

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-please-use-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com,*

# Database Configuration (SQLite for development, PostgreSQL for production)
# For SQLite (default):
DATABASE_URL=sqlite:///app/db.sqlite3

# For PostgreSQL (uncomment and configure):
# DATABASE_URL=postgresql://user:password@postgres:5432/leave_system

# Email Configuration
EMAIL_HOST=smtp.yourcompany.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yourcompany.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Company Leave System <noreply@yourcompany.com>

# SMS Gateway (optional)
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_URL=https://api.sms-gateway.com/send

# Real-time Notifications (Pusher)
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap1

# Server Configuration
PORT=8000
WORKERS=2

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# For production, enable these security settings:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True

# Logging
LOG_LEVEL=INFO

# Company Information
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=hr@yourcompany.com
COMPANY_PHONE=+1-234-567-8900

# Leave Policy Settings
MAX_CONSECUTIVE_DAYS=14
SPECIAL_LEAVE_CREDITS_PER_SESSION=0.5
ANNUAL_LEAVE_ENTITLEMENT=21
SICK_LEAVE_ENTITLEMENT=7

# Time Zone
TIME_ZONE=Asia/Hong_Kong

# Static and Media Files
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/app/static/
MEDIA_ROOT=/app/media/